# Base URL of the FastAPI backend. No secrets belong in this file.
VITE_API_BASE_URL=http://localhost:8000

# Base path for the built site. Use "/<repository-name>/" for GitHub Pages.
VITE_BASE_PATH=/

# Public profile links. Leave blank to hide the corresponding contact link.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_PUBLIC_EMAIL=

# Set to "true" only in non-production environments while the assistant is mocked.
VITE_SHOW_MOCK_NOTICE=
