# Base URL of the FastAPI backend. No secrets belong in this file.
VITE_API_BASE_URL=http://localhost:8000

# Base path for the built site. Use "/<repository-name>/" for GitHub Pages.
VITE_BASE_PATH=/

# Public profile links. Leave blank to hide the corresponding contact card link.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_PUBLIC_EMAIL=
VITE_RESUME_URL=/resume.pdf
