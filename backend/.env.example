# Phase 1 configuration. No external AI provider is contacted.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BUILD_COMMIT=local

# Comma-separated CORS allowlist. Wildcards are not permitted in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CORPUS_VERSION=2026-10
MAX_INPUT_CHARACTERS=500

# Phase 1 always serves deterministic mock answers. Live model calls arrive in Phase 3.
ENABLE_LIVE_MODEL_CALLS=false
