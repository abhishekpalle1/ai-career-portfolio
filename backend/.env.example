# Copy to .env. With the live flags false, no external AI provider is contacted.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BUILD_COMMIT=local

# Comma-separated CORS allowlist. Wildcards are not permitted in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CORPUS_VERSION=2026-10
MAX_INPUT_CHARACTERS=500

# Live RAG runs only when BOTH flags are true; otherwise deterministic mock answers are served.
ENABLE_LIVE_MODEL_CALLS=false
ENABLE_LIVE_RAG=false
# Used only by the offline ingestion CLI (python -m ingestion.cli --env-file backend/.env ...).
ENABLE_LIVE_VECTOR_UPSERTS=false

# Secrets: local .env only. In production, inject from Google Secret Manager.
GEMINI_API_KEY=
PINECONE_API_KEY=

# Embedding model and dimensions must match between ingestion, query time, and the Pinecone index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=800
PINECONE_INDEX=career-portfolio
PINECONE_NAMESPACE=development
EXTERNAL_TIMEOUT_SECONDS=15

RETRIEVAL_TOP_K=12
FINAL_CONTEXT_CHUNKS=5
# Leave empty until Phase 5 evaluation establishes values.
MIN_RETRIEVAL_SCORE=
MAX_CONTEXT_TOKENS=

# Phase 4 cost and abuse controls (in-memory; assumes a single Cloud Run instance).
MAX_QUESTIONS_PER_SESSION=10
MAX_QUESTIONS_PER_IP_PER_DAY=20
# Number of trusted proxies appending X-Forwarded-For. 0 = use the socket peer address only.
TRUSTED_PROXY_HOPS=0
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
MAX_GENERATION_RETRIES=0
MAX_ANSWER_CHARACTERS=1500
